<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.modernwpf.com/2019"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- cmux Light Theme — same key surface as DarkTheme.xaml, light palette.
         Activated when CmuxSettings.AppThemeMode = "Light". Restart-required. -->

    <!-- ═══════════════════════════════════════════════════════════════════
         Base Colors (light)
         ═══════════════════════════════════════════════════════════════════ -->
    <Color x:Key="BackgroundColor">#FFF7F7FA</Color>
    <Color x:Key="SidebarBackgroundColor">#FFEDEDF2</Color>
    <Color x:Key="SidebarItemHoverColor">#FFE0E0EC</Color>
    <Color x:Key="SidebarItemSelectedColor">#FFD8D8F0</Color>
    <Color x:Key="ForegroundColor">#FF1A1A1F</Color>
    <Color x:Key="ForegroundDimColor">#FF6B7280</Color>
    <Color x:Key="AccentColor">#FF6366F1</Color>
    <Color x:Key="NotificationColor">#FF4F46E5</Color>
    <Color x:Key="BorderColor">#FFD4D4DB</Color>
    <Color x:Key="SurfaceTabBackgroundColor">#FFE5E5EC</Color>
    <Color x:Key="SurfaceTabSelectedColor">#FFFFFFFF</Color>
    <Color x:Key="DividerColor">#FFE0E0E6</Color>
    <Color x:Key="ErrorColor">#FFDC2626</Color>
    <Color x:Key="SuccessColor">#FF059669</Color>
    <Color x:Key="WarningColor">#FFD97706</Color>

    <Color x:Key="AccentGlowColor">#806366F1</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceHighColor">#FFFAFAFC</Color>
    <Color x:Key="PurpleAccent">#FF7C3AED</Color>
    <Color x:Key="TealAccent">#FF0D9488</Color>
    <Color x:Key="PinkAccent">#FFDB2777</Color>
    <Color x:Key="OrangeAccent">#FFEA580C</Color>
    <Color x:Key="InputBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="CloseButtonHoverColor">#FFE81123</Color>

    <!-- ═══════════════════════════════════════════════════════════════════
         Layout Tokens (identical to dark)
         ═══════════════════════════════════════════════════════════════════ -->
    <system:Double x:Key="TitleBarHeight">38</system:Double>
    <CornerRadius x:Key="WindowCornerRadius">10</CornerRadius>
    <system:Double x:Key="ControlHeight">32</system:Double>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>

    <!-- ═══════════════════════════════════════════════════════════════════
         Brushes
         ═══════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="{StaticResource SidebarItemHoverColor}" />
    <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="{StaticResource SidebarItemSelectedColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="ForegroundDimBrush" Color="{StaticResource ForegroundDimColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="NotificationBrush" Color="{StaticResource NotificationColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SurfaceTabBackgroundBrush" Color="{StaticResource SurfaceTabBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceTabSelectedBrush" Color="{StaticResource SurfaceTabSelectedColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="{StaticResource SurfaceHighColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F2FFFFFF" />

    <!-- ModernWpf input chrome overrides (mirror of DarkTheme).
         60%-alpha ForegroundDim for muted placeholder text. -->
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#996B7280" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#996B7280" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#996B7280" />
    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource ForegroundColor}" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4F46E5" Offset="0.0" />
        <GradientStop Color="#FF6366F1" Offset="0.5" />
        <GradientStop Color="#FF818CF8" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFEDEDF2" Offset="0.0" />
        <GradientStop Color="#FFE5E5EC" Offset="1.0" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="SelectedTabGlow" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
        <GradientStop Color="#306366F1" Offset="0.0" />
        <GradientStop Color="#006366F1" Offset="1.0" />
    </RadialGradientBrush>

    <!-- ═══════════════════════════════════════════════════════════════════
         Effects
         ═══════════════════════════════════════════════════════════════════ -->
    <DropShadowEffect x:Key="FloatingShadow" BlurRadius="20" ShadowDepth="4"
                      Direction="270" Color="#33000000" Opacity="0.5" />

    <DropShadowEffect x:Key="SubtleShadow" BlurRadius="8" ShadowDepth="2"
                      Direction="270" Color="#22000000" Opacity="0.4" />

    <DropShadowEffect x:Key="GlowEffect" BlurRadius="16" ShadowDepth="0"
                      Direction="0" Color="{StaticResource AccentColor}" Opacity="0.5" />

    <DropShadowEffect x:Key="OverlayShadow" BlurRadius="20" ShadowDepth="4"
                      Direction="270" Color="#000000" Opacity="0.2" />

    <!-- ═══════════════════════════════════════════════════════════════════
         Font Sizes (identical to dark)
         ═══════════════════════════════════════════════════════════════════ -->
    <system:Double x:Key="FontSizeSmall">11</system:Double>
    <system:Double x:Key="FontSizeNormal">13</system:Double>
    <system:Double x:Key="FontSizeLarge">15</system:Double>
    <system:Double x:Key="FontSizeTitle">18</system:Double>

    <!-- ═══════════════════════════════════════════════════════════════════
         Animation Durations
         ═══════════════════════════════════════════════════════════════════ -->
    <Duration x:Key="FastAnimation">0:0:0.15</Duration>
    <Duration x:Key="NormalAnimation">0:0:0.25</Duration>
    <Duration x:Key="SlowAnimation">0:0:0.4</Duration>

    <!-- ═══════════════════════════════════════════════════════════════════
         CmuxButton — ghost button (BasedOn ModernWpf, mirror of DarkTheme)
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="CmuxButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource SidebarItemHoverColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource SidebarItemSelectedColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource ForegroundColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource ForegroundColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource ForegroundColor}" />
        </Style.Resources>
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         AccentButton — gradient CTA (BasedOn ModernWpf, mirror of DarkTheme)
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />
            <!-- Keep gradient on every state (matches DarkTheme). Light variant uses a
                 slightly darker base gradient for sufficient contrast on white. -->
            <LinearGradientBrush x:Key="ButtonBackground" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF4F46E5" Offset="0.0" />
                <GradientStop Color="#FF6366F1" Offset="0.5" />
                <GradientStop Color="#FF818CF8" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF5F56F5" Offset="0.0" />
                <GradientStop Color="#FF7376FF" Offset="0.5" />
                <GradientStop Color="#FF919BFF" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ButtonBackgroundPressed" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF3F36C5" Offset="0.0" />
                <GradientStop Color="#FF5356D1" Offset="0.5" />
                <GradientStop Color="#FF7176E8" Offset="1.0" />
            </LinearGradientBrush>
        </Style.Resources>
        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Effect" Value="{StaticResource SubtleShadow}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{StaticResource GlowEffect}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         IconButton — minimal toolbar icon (light hover)
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource SidebarItemHoverColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource SidebarItemSelectedColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource ForegroundDimColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource ForegroundColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource ForegroundColor}" />
        </Style.Resources>
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         Form labels (BasedOn ModernWpf type ramp — mirror of DarkTheme)
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="CmuxFormLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{StaticResource ForegroundDimBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
    </Style>

    <Style x:Key="CmuxSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         CmuxSearchBox — mirror of DarkTheme. One style for every search input.
         Placeholder color is the muted-60%-alpha brand foreground.
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="CmuxSearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="6"
                            Background="{DynamicResource SurfaceHighBrush}"
                            Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" />
                            <Grid Grid.Column="1">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              VerticalAlignment="Center" />
                                <TextBlock Text="{Binding (ui:ControlHelper.PlaceholderText), RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="#996B7280"
                                           FontSize="12" VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         CmuxColorSwatch
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="CmuxColorSwatch" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource ControlHeight}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         WindowChromeButton — light hover (subtle dark wash)
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="WindowChromeButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundDimBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#15000000" />
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#25000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowChromeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="Transparent"
                            Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                            CornerRadius="0,10,0,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFE81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFCC1020" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

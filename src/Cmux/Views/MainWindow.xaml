<Window x:Class="Cmux.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:Cmux.ViewModels"
        xmlns:views="clr-namespace:Cmux.Views"
        xmlns:controls="clr-namespace:Cmux.Controls"
        Title="cmux windows" Height="800" Width="1200"
        MinHeight="400" MinWidth="600"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        Loaded="OnLoaded" Closing="OnClosing"
        KeyDown="OnKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0"
                      ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Per-window SystemColors overrides removed (AGENTS.md UI rule 3): ThemeResources routes them. -->
        <Style x:Key="AppMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource SidebarBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style x:Key="AppMenuTopItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="TopItemBg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="TopItemBg" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="TopItemBg" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppMenuSubItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="SubItemBg" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True" />
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="14,0,0,0"
                                           Foreground="{StaticResource ForegroundDimBrush}" FontSize="11" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="SubItemBg" Property="Background" Value="{DynamicResource SidebarItemSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ForegroundDimBrush}" />
                                <Setter TargetName="SubItemBg" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="6,4" Background="{DynamicResource BorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border x:Name="WindowBorder" Background="{StaticResource BackgroundBrush}"
            CornerRadius="{StaticResource WindowCornerRadius}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Clip>
            <RectangleGeometry x:Name="WindowClipGeometry" RadiusX="10" RadiusY="10" />
        </Border.Clip>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- Menu items -->
                        <ColumnDefinition Width="*" />    <!-- Drag area -->
                        <ColumnDefinition Width="Auto" /> <!-- Window buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Menu items (left side) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="AppVersionLabel" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="14,0,12,0" />
                        <Menu Style="{StaticResource AppMenuStyle}" VerticalAlignment="Center">
                            <Menu.Resources>
                                <Style TargetType="Separator" BasedOn="{StaticResource AppMenuSeparatorStyle}" />
                            </Menu.Resources>
                            <MenuItem Header="_File" Style="{StaticResource AppMenuTopItemStyle}" ItemContainerStyle="{StaticResource AppMenuSubItemStyle}">
                                <MenuItem Header="_New Workspace" Command="{Binding CreateNewWorkspaceCommand}" InputGestureText="Ctrl+N" />
                                <MenuItem Header="New _Surface" Command="{Binding SelectedWorkspace.CreateNewSurfaceCommand}" InputGestureText="Ctrl+T" />
                                <Separator />
                                <MenuItem Header="Open Command _Logs" Click="MenuOpenLogs_Click" InputGestureText="Ctrl+Shift+L" />
                                <MenuItem Header="Open Session _Vault" Click="MenuOpenSessionVault_Click" InputGestureText="Ctrl+Shift+V" />
                                <Separator />
                                <MenuItem Header="_Settings" Click="MenuOpenSettings_Click" InputGestureText="Ctrl+," />
                                <Separator />
                                <MenuItem Header="E_xit" Click="CloseButton_Click" />
                            </MenuItem>
                            <MenuItem Header="_Window" Style="{StaticResource AppMenuTopItemStyle}" ItemContainerStyle="{StaticResource AppMenuSubItemStyle}">
                                <MenuItem Header="Split _Right" Click="ToolbarSplitRight_Click" InputGestureText="Ctrl+D" />
                                <MenuItem Header="Split _Down" Click="ToolbarSplitDown_Click" InputGestureText="Ctrl+Shift+D" />
                                <MenuItem Header="_Zoom Pane" Click="ToolbarZoom_Click" InputGestureText="Ctrl+Shift+Z" />
                                <MenuItem Header="_Equalize Panes" Click="ToolbarEqualize_Click" />
                                <Separator />
                                <MenuItem Header="_Search" Click="Search_Click" InputGestureText="Ctrl+Shift+F" />
                                <MenuItem Header="Command _Palette" Click="CommandPalette_Click" InputGestureText="Ctrl+Shift+P" />
                                <MenuItem Header="_Snippets" Click="Snippets_Click" />
                                <Separator />
                                <MenuItem Header="Toggle _Sidebar" Command="{Binding ToggleSidebarCommand}" InputGestureText="Ctrl+B" />
                            </MenuItem>
                            <MenuItem Header="_Help" Style="{StaticResource AppMenuTopItemStyle}" ItemContainerStyle="{StaticResource AppMenuSubItemStyle}">
                                <MenuItem Header="Keyboard Shortcuts" Click="MenuOpenKeyboardShortcuts_Click" />
                                <MenuItem Header="About" Click="MenuAbout_Click" />
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                    <!-- Drag area (center) -->
                    <Border Grid.Column="1" Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

                    <!-- Window control buttons (right side) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowChromeButton}" Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <ui:FontIcon Glyph="&#xE921;" FontSize="10" />
                        </Button>
                        <Button x:Name="MaxRestoreButton" Style="{StaticResource WindowChromeButton}"
                                Click="MaximizeButton_Click" ToolTip="Maximize">
                            <ui:FontIcon x:Name="MaxRestoreIcon" Glyph="&#xE922;" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click"
                                ToolTip="Close">
                            <ui:FontIcon Glyph="&#xE8BB;" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="280" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Sidebar top actions -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="8,8,8,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                                    <TextBlock Text="Workspaces" Foreground="{StaticResource ForegroundBrush}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Manage sessions and environments" Foreground="{StaticResource ForegroundDimBrush}" FontSize="10" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" ToolTip="New Workspace (Ctrl+N)"
                                            Width="24" Height="24" Command="{Binding CreateNewWorkspaceCommand}">
                                        <ui:FontIcon Glyph="&#xE710;" FontSize="10" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="Session Vault (Ctrl+Shift+V)"
                                            Width="24" Height="24" Click="MenuOpenSessionVault_Click">
                                        <ui:FontIcon Glyph="&#xE8D1;" FontSize="10" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="Command Logs (Ctrl+Shift+L)"
                                            Width="24" Height="24" Click="MenuOpenLogs_Click">
                                        <ui:FontIcon Glyph="&#xE7BA;" FontSize="10" />
                                    </Button>
                                </StackPanel>

                                <TextBox x:Name="WorkspaceFilterBox"
                                         Grid.Row="1" Grid.ColumnSpan="2"
                                         Style="{StaticResource CmuxSearchBox}"
                                         Margin="0,10,0,6"
                                         ui:ControlHelper.PlaceholderText="Filter workspaces…"
                                         ToolTip="Filter workspaces by name, branch, or directory"
                                         TextChanged="WorkspaceFilterBox_TextChanged" />
                            </Grid>
                        </Border>

                        <!-- Workspace list -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding Workspaces}"
                                 SelectedItem="{Binding SelectedWorkspace}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="True" Padding="4,4,4,0"
                                 x:Name="WorkspaceList">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
                                    <controls:WorkspaceSidebarItem />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <!-- Hand cursor on the ListBoxItem itself so the entire row
                                         (including the inner Border padding outside the
                                         WorkspaceSidebarItem child) shows the pointer. -->
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <!-- Active indicator bar (left edge) -->
                                                    <Rectangle x:Name="activeBar" Width="3" HorizontalAlignment="Left"
                                                               RadiusX="1.5" RadiusY="1.5" Opacity="0"
                                                               Margin="0,4">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                <GradientStop Color="#FF6366F1" Offset="0" />
                                                                <GradientStop Color="#FFA78BFA" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <Border x:Name="border" Background="{TemplateBinding Background}"
                                                            CornerRadius="8" Padding="10,8" Margin="6,0,2,0">
                                                        <ContentPresenter />
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background"
                                                                Value="{StaticResource SidebarItemHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="border" Property="Background"
                                                                Value="{StaticResource SidebarItemSelectedBrush}" />
                                                        <Setter TargetName="activeBar" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="WorkspaceItem_PreviewMouseDown" />
                                    <EventSetter Event="PreviewMouseMove" Handler="WorkspaceItem_PreviewMouseMove" />
                                    <EventSetter Event="Drop" Handler="WorkspaceItem_Drop" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Sidebar footer -->
                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0" Padding="6,6">
                            <StackPanel>
                                <Button Command="{Binding CreateNewWorkspaceCommand}"
                                        Style="{StaticResource CmuxButton}"
                                        HorizontalAlignment="Stretch" Margin="0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:FontIcon Glyph="&#xE710;" FontSize="12"
                                                     Margin="0,0,8,0" Opacity="0.6" />
                                        <TextBlock Text="New Workspace" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ToggleNotificationPanelCommand}"
                                        Style="{StaticResource CmuxButton}"
                                        HorizontalAlignment="Stretch" Margin="0,8,0,1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon Glyph="&#xEA8F;" FontSize="12"
                                                         Margin="0,0,8,0" Opacity="0.6" />
                                            <TextBlock Text="Notifications" FontSize="12" />
                                        </StackPanel>
                                        <Border CornerRadius="10"
                                                Padding="6,2" HorizontalAlignment="Right"
                                                Visibility="{Binding TotalUnreadCount, Converter={StaticResource IntToVisibility}}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FF6366F1" Offset="0" />
                                                    <GradientStop Color="#FFA78BFA" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding TotalUnreadCount}" FontSize="10"
                                                       Foreground="White" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Vertical divider -->
                <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}"
                              HorizontalAlignment="Stretch" />

                <!-- Content area -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Surface tabs -->
                        <RowDefinition Height="Auto" /> <!-- Toolbar -->
                        <RowDefinition Height="*" />    <!-- Terminal content -->
                        <RowDefinition Height="Auto" /> <!-- Status bar -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Surface tabs -->
                    <controls:SurfaceTabBar x:Name="SurfaceTabBarControl" Grid.Row="0" Grid.Column="0"
                        DataContext="{Binding SelectedWorkspace}" />

                    <!-- Toolbar -->
                    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="6,2">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" ToolTip="Split Right (Ctrl+D)"
                                    Click="ToolbarSplitRight_Click">
                                <ui:FontIcon Glyph="&#xE26B;" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="Split Down (Ctrl+Shift+D)"
                                    Click="ToolbarSplitDown_Click">
                                <ui:FontIcon Glyph="&#xE74B;" FontSize="12" />
                            </Button>
                            <Button x:Name="ShellSelectorButton" Style="{StaticResource IconButton}"
                                    ToolTip="Open pane with shell..."
                                    Click="ShellSelector_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE756;" FontSize="12" />
                                    <ui:FontIcon Glyph="&#xE70D;" FontSize="7" Margin="2,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Rectangle Width="1" Height="16" Fill="{StaticResource BorderBrush}" Margin="4,0" />
                            <Button Style="{StaticResource IconButton}" ToolTip="Layout: 2 Columns"
                                    Click="ToolbarLayout2Col_Click">
                                <ui:FontIcon Glyph="&#xE8A1;" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="Layout: Grid 2x2"
                                    Click="ToolbarLayoutGrid_Click">
                                <ui:FontIcon Glyph="&#xE8A9;" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="Layout: Main + Stack"
                                    Click="ToolbarLayoutMainStack_Click">
                                <ui:FontIcon Glyph="&#xE89F;" FontSize="11" />
                            </Button>
                            <Rectangle Width="1" Height="16" Fill="{StaticResource BorderBrush}" Margin="4,0" />
                            <Button Style="{StaticResource IconButton}" ToolTip="Equalize Panes"
                                    Click="ToolbarEqualize_Click">
                                <ui:FontIcon Glyph="&#xE9D5;" FontSize="11" />
                            </Button>
                            <Button x:Name="ToolbarZoomButton" Style="{StaticResource IconButton}" ToolTip="Zoom Pane (Ctrl+Shift+Z)"
                                    Click="ToolbarZoom_Click">
                                <ui:FontIcon x:Name="ToolbarZoomIcon" Glyph="&#xE740;" FontSize="12" />
                            </Button>
                            <Rectangle Width="1" Height="16" Fill="{StaticResource BorderBrush}" Margin="4,0" />
                            <Button Style="{StaticResource IconButton}" ToolTip="System Info (Ctrl+Shift+I)"
                                    Command="{Binding ToggleInfoPanelCommand}">
                                <ui:FontIcon Glyph="&#xE9D9;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Terminal content -->
                    <ContentControl Grid.Row="2" Grid.Column="0" x:Name="ContentArea">
                        <controls:SplitPaneContainer x:Name="SplitPaneContainerControl"
                            DataContext="{Binding SelectedWorkspace.SelectedSurface}" />
                    </ContentControl>

                    <!-- Info panel overlay -->
                    <controls:InfoPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                        HorizontalAlignment="Right"
                        Visibility="{Binding InfoPanelVisible, Converter={StaticResource BoolToVisibility}}"
                        DataContext="{Binding}" />

                    <!-- Notification panel overlay -->
                    <controls:NotificationPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                        HorizontalAlignment="Right"
                        Visibility="{Binding NotificationPanelVisible, Converter={StaticResource BoolToVisibility}}"
                        DataContext="{Binding}" />

                    <!-- Command palette overlay -->
                    <controls:CommandPalette Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                        x:Name="CommandPaletteControl"
                        Visibility="Collapsed" />

                    <!-- Snippet picker overlay -->
                    <controls:SnippetPicker Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                        x:Name="SnippetPickerControl"
                        Visibility="Collapsed" />

                    <!-- Status bar -->
                    <Border Grid.Row="3" Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="10,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <!-- Git branch -->
                                <ui:FontIcon Glyph="&#xE8AD;" FontSize="10"
                                             Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center"
                                             Margin="0,0,4,0" />
                                <TextBlock Text="{Binding SelectedWorkspace.GitBranch, FallbackValue=''}" FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                           Margin="0,0,16,0" />
                                <!-- Working directory -->
                                <ui:FontIcon Glyph="&#xE8B7;" FontSize="10"
                                             Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center"
                                             Margin="0,0,4,0" />
                                <TextBlock Text="{Binding SelectedWorkspace.WorkingDirectory, FallbackValue=''}" FontSize="11"
                                           Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="300" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- Ports -->
                                <TextBlock Text="{Binding SelectedWorkspace.PortsDisplay, FallbackValue=''}" FontSize="10"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           Visibility="{Binding SelectedWorkspace.PortsDisplay, Converter={StaticResource NullToCollapsed}}" />
                                <!-- Pane count -->
                                <ui:FontIcon Glyph="&#xE737;" FontSize="10"
                                             Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center"
                                             Margin="0,0,4,0" />
                                <TextBlock x:Name="PaneCountText" Text="1 pane" FontSize="11"
                                           Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <!-- Daemon status -->
                                <Border x:Name="DaemonStatusBorder" CornerRadius="3" Padding="5,1" Margin="0,0,12,0"
                                        VerticalAlignment="Center" Background="Transparent">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="DaemonStatusDot" Width="6" Height="6"
                                                 Fill="#FF6B7280" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DaemonStatusText" Text="Daemon" FontSize="10"
                                                   Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <!-- Shortcuts hint -->
                                <TextBlock Text="Ctrl+Shift+P: Commands" FontSize="10"
                                           Foreground="{StaticResource ForegroundDimBrush}" VerticalAlignment="Center"
                                           Opacity="0.6" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>

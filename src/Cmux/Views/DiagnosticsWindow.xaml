<Window x:Class="Cmux.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Diagnostics"
        Width="900" Height="600"
        Background="{StaticResource SurfaceBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filter bar -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Level" VerticalAlignment="Center"
                       Margin="0,0,8,0" Foreground="{StaticResource ForegroundDimBrush}" />
            <ComboBox x:Name="LevelCombo" Grid.Column="1"
                      SelectionChanged="LevelCombo_SelectionChanged">
                <ComboBoxItem Content="Debug" Tag="Debug" />
                <ComboBoxItem Content="Info" Tag="Info" IsSelected="True" />
                <ComboBoxItem Content="Warn" Tag="Warn" />
                <ComboBoxItem Content="Error" Tag="Error" />
            </ComboBox>

            <TextBlock Grid.Column="2" Text="Category" VerticalAlignment="Center"
                       Margin="16,0,8,0" Foreground="{StaticResource ForegroundDimBrush}" />
            <TextBox x:Name="CategoryFilter" Grid.Column="3"
                     ui:ControlHelper.PlaceholderText="filter substring (e.g. MoveTo, Toast, Daemon)"
                     TextChanged="CategoryFilter_TextChanged" />

            <ui:ToggleSwitch x:Name="PauseToggle" Grid.Column="4"
                             OffContent="Live" OnContent="Paused"
                             Margin="16,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <!-- Master toggle row -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:ToggleSwitch x:Name="EnabledToggle" Grid.Column="0"
                             OffContent="Diagnostic logging is OFF — enable to start recording"
                             OnContent="Diagnostic logging is ON"
                             Toggled="EnabledToggle_Toggled" />
            <TextBlock x:Name="StatusText" Grid.Column="1"
                       Foreground="{StaticResource ForegroundDimBrush}" FontSize="11"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Log list -->
        <Border Grid.Row="2" CornerRadius="6"
                Background="{StaticResource SurfaceHighBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1">
            <ListBox x:Name="EntriesList"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono,Consolas" FontSize="12"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                       Foreground="{StaticResource ForegroundDimBrush}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding LevelText}"
                                       Foreground="{Binding LevelBrush}" Width="56" />
                            <TextBlock Grid.Column="2" Text="{Binding Category}"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="{Binding Message}"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Clear" Style="{StaticResource CmuxButton}" Click="Clear_Click" Margin="0,0,8,0" />
            <Button Content="Copy All" Style="{StaticResource CmuxButton}" Click="CopyAll_Click" Margin="0,0,8,0" />
            <Button Content="Open Log Folder" Style="{StaticResource CmuxButton}" Click="OpenFolder_Click" Margin="0,0,8,0" />
            <Button Content="Close" Style="{StaticResource AccentButton}" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
